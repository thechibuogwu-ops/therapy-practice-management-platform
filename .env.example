DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Required in production: long, unpredictable server-only value.
AUTH_SECRET=replace-with-a-long-random-secret
# Canonical server URL used for payment callbacks and development activation links.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Invitation / demo controls
INVITATION_EXPIRY_DAYS=7
# Manual activation URLs require this flag AND NODE_ENV=development or APP_ENV=demo.
# Keep false or unset in production.
SHOW_INVITATION_URLS=false
# APP_ENV=demo

# Payment providers. Never prefix server secrets with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_CHECKOUT_EXPIRY_MINUTES=30

# Email delivery may be configured in a future mail adapter; no email is simulated when absent.
EMAIL_FROM=
SMTP_URL=
RESEND_API_KEY=

# Private communication and storage limits.
# Set either MAX_UPLOAD_MB or MAX_UPLOAD_SIZE_BYTES. Default is 10 MB.
MAX_UPLOAD_MB=10
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_MESSAGE_LENGTH=4000
MAX_SESSION_NOTE_LENGTH=12000
